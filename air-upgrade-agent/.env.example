# AIR UPGRADE AGENT - copy to .env (git-ignored).
# NEVER put an airline password here: you log in manually in the isolated
# browser opened by the agent.

# --- Microsoft Foundry / Azure OpenAI (optional: the deterministic engine works without)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_FOUNDRY_PROJECT=

# --- Safety
DRY_RUN=true
DEBUG_MODE=false

# --- FREE UPGRADE mode (also adjustable at runtime from the dashboard, no code change)
CASH_LIMIT=0
MILES_LIMIT=0
PASSENGERS_TARGET=3

# --- Monitoring cadence (seconds)
POLL_INTERVAL_SECONDS=300
MINIMUM_CHECK_INTERVAL=120
MAXIMUM_CHECK_INTERVAL=3600

# --- Provider: "mock" (MOCK AIR FRANCE, default) or "airfrance" (real site, manual login)
PROVIDER=mock
MOCK_SCENARIO=free_upgrade_3_business
BROWSER_HEADLESS=false
# BROWSER_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# --- Storage (SQLite for the MVP; PostgreSQL: postgresql+psycopg://user:pass@host/db)
# DATABASE_URL=sqlite:///./data/air_upgrade_agent.db
SCREENSHOT_RETENTION_HOURS=24
CONFIRMATION_TTL_SECONDS=900
